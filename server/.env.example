PORT=5000
NODE_ENV=development

MONGO_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Vite's dev server defaults to 5173, not CRA's 3000 — update to match
# whichever port your frontend actually runs on, comma-separated if you
# need more than one (e.g. local + deployed).
CLIENT_URLS=http://localhost:5173
# Set to the exact number of trusted reverse-proxy hops in production.
# Render/Railway commonly use 1; leave empty for direct/local connections.
TRUST_PROXY=
# Only set during the documented unique-index migration when application
# writes have actually been stopped and the server cannot build side-by-side.
INDEX_MIGRATION_WRITE_FREEZE=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DAILY_API_KEY=
DAILY_DOMAIN=
